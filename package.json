{
  "name": "CASCaRA-Reference-Implementation",
  "version": "0.3.7",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-common-public.js",
    "generate:ras30-types": "tsx scripts/ras30-to-cas.ts",
    "build:xslt": "node scripts/compile-xslt.js",
    "build:vue": "npm run build -w @cascara/vue",
    "build": "npm run build:xslt && npm run build:vue",
    "serve": "npm run serve -w @cascara/vue",
    "lint": "npm run lint -w @cascara/vue",
    "test:logic": "npm run test -w @cascara/common",
    "test:unit": "node scripts/link-common-public.js && npm run test -w @cascara/common && npm run test -w @cascara/vue",
    "test:browser": "playwright test",
    "test:all": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "cross-spawn": ">=6.0.6"
  }
}
