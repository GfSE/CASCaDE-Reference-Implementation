{
  "name": "CASCaRA-Validation-Tool",
  "version": "0.3.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:xslt": "node scripts/compile-xslt.js",
    "build:vue": "npm run build -w @cascade/vue",
    "build": "npm run build:xslt && npm run build:vue",
    "serve": "npm run serve -w @cascade/vue",
    "lint": "npm run lint -w @cascade/vue",
    "test:logic": "npm run test -w @cascade/common",
    "test:unit": "npm run test -w @cascade/common && npm run test -w @cascade/vue",
    "test:xslt": "playwright test",
    "test:all": "npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "typescript": "4.7"
  },
  "overrides": {
    "cross-spawn": ">=6.0.6"
  }
}

