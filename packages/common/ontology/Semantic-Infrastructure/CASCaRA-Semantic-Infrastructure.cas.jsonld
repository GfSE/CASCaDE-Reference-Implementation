          "@value": "Organizer",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A CASCaRA type for elements organizing entities and relationships; is abstract. An example is a list of requirements or a diagram using a certain notation.",
          "@language": "en"
        }
      ],
      "cas:enumeratedProperty": [
        {
          "@id": "cas:Category"
        }
      ],
      "cas:enumeratedTargetLink": []
    },
