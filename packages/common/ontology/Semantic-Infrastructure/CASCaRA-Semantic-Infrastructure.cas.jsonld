        "@id": "cas:Link"
      },
      "dcterms:title": [
        {
          "@value": "Link",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A CASCaRA meta-model item connecting a reified relationship with its source or target. Also connects an organizer to a model element",
