{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@cascara/common/*": [
        "src/*"
      ]
    },
    "types": [
      "node",
      "jest"
    ],
    "lib": [
      "es2020",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts",
