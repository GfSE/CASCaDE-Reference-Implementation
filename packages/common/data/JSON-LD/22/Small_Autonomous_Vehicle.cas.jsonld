    {
      "@id": "d:_18_5_3_bc402f4_1552810776263_894029_14121",
      "@type": "IREB:Requirement",
      "cas:itemType": {
        "@id": "cas:anEntity"
      },
      "dcterms:title": [
        {
          "@value": "Navigation"
        }
      ],
      "dcterms:description": [
        {
          "@value": "The Vehicle shall autonomously choose the best route from the current location C to the target location T by means of a road map and actual traffic conditions."
        }
      ],
      "dcterms:modified": "2025-09-24T08:28:08.223Z",
      "cas:Category": [
        {
          "@value": "uml:Class"
        }
      ]
    },
