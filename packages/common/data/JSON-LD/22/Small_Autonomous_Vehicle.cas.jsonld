    {
      "@id": "oslc_rm:satisfies",
      "@type": "owl:Class",
      "cas:itemType": {
        "@id": "cas:Relationship"
      },
      "cas:specializes": {
        "@id": "cas:Relationship"
      },
      "dcterms:title": [
