        },
        {
          "@value": "Modellelement",
          "@language": "de"
        }
      ],
      "skos:definition": [
        {
          "@value": "Is a generalized type for model elements.",
          "@language": "en"
        },
        {
          "@value": "Ist ein generalisierter Typ für Modellelemente.",
          "@language": "de"
        }
      ],
