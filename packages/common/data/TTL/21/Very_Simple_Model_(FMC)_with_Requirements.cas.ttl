	sh:property cas:Category_shape .

SpecIF:writes
	a owl:Class ;
	rdfs:subClassOf cas:Relationship ;
	rdfs:label "writes"@en ,
		"schreibt"@de ,
		"écrit"@fr ;
	skos:definition "A [[FMC:Actor]] 'writes' (changes) a [[FMC:State]]."@en ;
	dcterms:modified "2018-05-10T11:54:00+01:00"^^xs:dateTime .

SpecIF:writes_shape
	a sh:NodeShape ;
	sh:targetClass SpecIF:writes ;
	sh:property SpecIF:writes-toSource_shape ;
	sh:property SpecIF:writes-toTarget_shape .

SpecIF:writes-toSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksSource ;
	rdfs:label "SpecIF:writes to source" ;
	rdfs:comment "Connects the source of SpecIF:writes" ;
	rdfs:range FMC:Actor .

SpecIF:writes-toSource_shape
	a sh:PropertyShape ;
	sh:path SpecIF:writes-toSource ;
	sh:class FMC:Actor .

SpecIF:writes-toTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "SpecIF:writes to target" ;
	rdfs:comment "Connects the target of SpecIF:writes" ;
	rdfs:range FMC:State .

SpecIF:writes-toTarget_shape
	a sh:PropertyShape ;
	sh:path SpecIF:writes-toTarget ;
	sh:class FMC:State .

SpecIF:reads
	a owl:Class ;
	rdfs:subClassOf cas:Relationship ;
	rdfs:label "reads"@en ,
		"liest"@de ,
		"lit"@fr ;
	skos:definition "A [[FMC:Actor]] 'reads' a [[FMC:State]]."@en ;
	dcterms:modified "2018-05-10T11:54:00+01:00"^^xs:dateTime .

SpecIF:reads_shape
	a sh:NodeShape ;
	sh:targetClass SpecIF:reads ;
	sh:property SpecIF:reads-toSource_shape ;
	sh:property SpecIF:reads-toTarget_shape .

SpecIF:reads-toSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksSource ;
	rdfs:label "SpecIF:reads to source" ;
	rdfs:comment "Connects the source of SpecIF:reads" ;
	rdfs:range FMC:Actor .

SpecIF:reads-toSource_shape
	a sh:PropertyShape ;
	sh:path SpecIF:reads-toSource ;
	sh:class FMC:Actor .

SpecIF:reads-toTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "SpecIF:reads to target" ;
	rdfs:comment "Connects the target of SpecIF:reads" ;
	rdfs:range FMC:State .

SpecIF:reads-toTarget_shape
	a sh:PropertyShape ;
	sh:path SpecIF:reads-toTarget ;
	sh:class FMC:State .

oslc_rm:satisfies
	a owl:Class ;
	rdfs:subClassOf cas:Relationship ;
	rdfs:label "satisfies"@en ,
		"erfüllt"@de ,
		"satisfait"@fr ;
	skos:definition "<p>The object is satisfied by the subject. <small>(<i>source: <a href=\"http://open-services.net/\">OSLC</a></i>)</small></p><p>SpecIF suggests that the subject is confined to a model element, e.g, a [[FMC:Actor]] or [[FMC:State]], and the object is confined to a [[IREB:Requirement]]. More concretely, an example for this type of statement is 'Component-X <em>satisfies</em> 'Requirement-4711'.</p>"@en ;
	dcterms:modified "2016-05-26T08:59:00+02:00"^^xs:dateTime .

oslc_rm:satisfies_shape
	a sh:NodeShape ;
	sh:targetClass oslc_rm:satisfies ;
	sh:property oslc_rm:satisfies-toSource_shape ;
	sh:property oslc_rm:satisfies-toTarget_shape .

oslc_rm:satisfies-toSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksSource ;
	rdfs:label "oslc_rm:satisfies to source" ;
	rdfs:comment "Connects the source of oslc_rm:satisfies" ;
	rdfs:range [ owl:unionOf ( FMC:Actor FMC:State ) ] .

oslc_rm:satisfies-toSource_shape
	a sh:PropertyShape ;
	sh:path oslc_rm:satisfies-toSource ;
	sh:or ( [ sh:class FMC:Actor ] [ sh:class FMC:State ] ) .

oslc_rm:satisfies-toTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "oslc_rm:satisfies to target" ;
	rdfs:comment "Connects the target of oslc_rm:satisfies" ;
	rdfs:range IREB:Requirement .

oslc_rm:satisfies-toTarget_shape
	a sh:PropertyShape ;
	sh:path oslc_rm:satisfies-toTarget ;
	sh:class IREB:Requirement .

