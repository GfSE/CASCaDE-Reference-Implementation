	<IREB:Requirement id="d:Req-1a8016e2872e78ecadc50feddc00029b" cas:itemType="cas:anEntity">
		<dcterms:title>Data Volume</dcterms:title>
		<dcterms:description><p>The data store MUST support a total volume up to 850 GB.</p></dcterms:description>
		<dcterms:modified>2020-10-17T10:00:00+01:00</dcterms:modified>
		<SpecIF:Priority cas:itemType="cas:aTargetLink">
			<idRef>SpecIF:priorityHigh</idRef>
		</SpecIF:Priority>
	</IREB:Requirement>
	<IREB:Requirement id="d:Req-0Z7916e2872e78ecadc50feddc00918a" cas:itemType="cas:anEntity">
		<dcterms:title>Consistency</dcterms:title>
		<dcterms:description><p>The data store MUST be consistent at all times.</p></dcterms:description>
		<dcterms:modified>2020-10-17T10:00:00+01:00</dcterms:modified>
		<SpecIF:Priority cas:itemType="cas:aTargetLink">
			<idRef>SpecIF:priorityHigh</idRef>
		</SpecIF:Priority>
	</IREB:Requirement>
	<IREB:Requirement id="d:Req-2b9016e2872e78ecadc50feddc0013Ac" cas:itemType="cas:anEntity">
		<dcterms:title>Response Time</dcterms:title>
		<dcterms:description><p>The system SHOULD respond on user queries within 300 ms.</p></dcterms:description>
		<dcterms:modified>2020-10-17T10:00:00+01:00</dcterms:modified>
		<SpecIF:Priority cas:itemType="cas:aTargetLink">
			<idRef>SpecIF:priorityMedium</idRef>
		</SpecIF:Priority>
	</IREB:Requirement>
