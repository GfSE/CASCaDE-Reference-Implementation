<?xml version="1.0" encoding="UTF-8"?>
<cas:Package
	xmlns:cas="https://product-information-graph.org/ontology/2026-05-08/metamodel#"
	xmlns:dcterms="http://purl.org/dc/terms/"
	xmlns:skos="https://www.w3.org/TR/skos-reference/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:o="https://product-information-graph.org/ontology/custom#"
	xmlns:d="https://product-information-graph.org/examples/09_Very-Simple-Model-FMC-with-Requirements.specif.zip#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:xs="http://www.w3.org/2001/XMLSchema#"
	xmlns:FMC="http://fmc-modeling.org#"
	xmlns:IREB="https://cpre.ireb.org/en/downloads-and-resources/glossary#"
	xmlns:ReqIF="https://www.prostep.org/fileadmin/downloads/PSI_ImplementationGuide_ReqIF_V1-7.pdf#"
	xmlns:oslc_rm="http://open-services.net/ns/rm#"
	xmlns:SpecIF="https://specif.de/v1.2/schema#"
	id="d:ACP-Very-Simple-Model-FMC-with-Requirements"
	cas:itemType="cas:aPackage">

	<dcterms:title>Very Simple Model (FMC) with Requirements</dcterms:title>
	<dcterms:modified>2026-01-17T22:38:19.595Z</dcterms:modified>
	<dcterms:contributor cas:itemType="cas:aProperty">
		<value>mailto:oskar.dungern@gfse.org</value>
	</dcterms:contributor>
	<dcterms:license cas:itemType="cas:aProperty">
		<value>https://creativecommons.org/licenses/by-sa/4.0/</value>
	</dcterms:license>

	<graph>
	<owl:Class id="cas:Package" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title>Package</dcterms:title>
		<skos:definition>A CASCaRA meta-model item used for packages comprising entities, relationships and potentially nested packages, both classes and instances.</skos:definition>
		<cas:enumeratedProperty>
			<idRef>dcterms:contributor</idRef>
			<idRef>dcterms:license</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="cas:Organizer" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title>Organizer</dcterms:title>
		<skos:definition>An element organizing model elements. An example is a list of requirements or a diagram using a certain notation.</skos:definition>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="cas:Root" cas:itemType="cas:Entity">
		<cas:specializes>cas:Organizer</cas:specializes>
		<dcterms:title>Hierarchy Root</dcterms:title>
		<skos:definition>A subclass of CASCaRA organizer serving as a root for hierarchically organized graph elements.</skos:definition>
		<cas:enumeratedTargetLink>
			<idRef>cas:lists</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:Class id="cas:Outline" cas:itemType="cas:Entity">
		<cas:specializes>cas:Organizer</cas:specializes>
		<dcterms:title>Outline</dcterms:title>
		<skos:definition>A subclass of CASCaRA organizer comprising all information items of a human-readable document. As usual, the outline is hierarchically organized.</skos:definition>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
		<cas:enumeratedTargetLink>
			<idRef>cas:lists</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:Class id="cas:View" cas:itemType="cas:Entity">
		<cas:specializes>cas:Organizer</cas:specializes>
		<dcterms:title>View</dcterms:title>
		<skos:definition>A subclass of CASCaRA organizer representing a model view (diagram) using a certain notation showing selected model elements.</skos:definition>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
			<idRef>cas:Diagram</idRef>
		</cas:enumeratedProperty>
		<cas:enumeratedTargetLink>
			<idRef>cas:shows</idRef>
			<idRef>cas:depicts</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:DatatypeProperty id="cas:Category" cas:itemType="cas:Property">
		<cas:specializes>cas:Property</cas:specializes>
		<dcterms:title>has category</dcterms:title>
		<skos:definition>Specifies a category for an element (entity, relationship or organizer).</skos:definition>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="32"/>
				<xs:minOccurs>0</xs:minOccurs>
				<xs:maxOccurs>1</xs:maxOccurs>
			</xs:restriction>
		</xs:simpleType>
	</owl:DatatypeProperty>
	<owl:ObjectProperty id="cas:linksSource" cas:itemType="cas:Link">
		<cas:specializes>cas:Link</cas:specializes>
		<dcterms:title>to source</dcterms:title>
		<skos:definition>Connects the source of a reified relationship.</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>cas:Entity</idRef>
			<idRef>cas:Relationship</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="cas:linksTarget" cas:itemType="cas:Link">
		<cas:specializes>cas:Link</cas:specializes>
		<dcterms:title>to target</dcterms:title>
		<skos:definition>Connects the target of a reified relationship or an organizer.</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>cas:Entity</idRef>
			<idRef>cas:Relationship</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="cas:lists" cas:itemType="cas:Link">
		<cas:specializes>cas:linksTarget</cas:specializes>
		<dcterms:title>lists</dcterms:title>
		<skos:definition>Lists an entity, a relationship or a subordinated organizer.</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>cas:Entity</idRef>
			<idRef>cas:Relationship</idRef>
			<idRef>cas:Organizer</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="cas:shows" cas:itemType="cas:Link">
		<cas:specializes>cas:linksTarget</cas:specializes>
		<dcterms:title>shows</dcterms:title>
		<skos:definition>Shows an entity or a relationship.</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>cas:Entity</idRef>
			<idRef>cas:Relationship</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="cas:depicts" cas:itemType="cas:Link">
		<cas:specializes>cas:linksTarget</cas:specializes>
		<dcterms:title>depicts</dcterms:title>
		<skos:definition>Depicts an entity; inverse of uml:ownedDiagram.</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>cas:Entity</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:DatatypeProperty id="dcterms:title" cas:itemType="cas:Property">
		<dcterms:title xml:lang="en">Title</dcterms:title>
		<dcterms:title xml:lang="de">Titel</dcterms:title>
		<dcterms:title xml:lang="fr">Titre</dcterms:title>
		<dcterms:description xml:lang="en"><p> A name given to the resource. <small> (<i> source: <a href="http://purl.org/dc/elements/1.1/title">DCMI</a></i>) </small></p><p> Title (reference: Dublin Core) of the resource represented as rich text in XHTML content. SHOULD include only content that is valid inside an XHTML 'span' element. <small> (<i> source: <a href="http://open-services.net/">OSLC</a></i>) </small></p></dcterms:description>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="256"/>
				<xs:maxOccurs>1</xs:maxOccurs>
			</xs:restriction>
		</xs:simpleType>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty id="dcterms:description" cas:itemType="cas:Property">
		<dcterms:title xml:lang="en">Description</dcterms:title>
		<dcterms:title xml:lang="de">Beschreibung</dcterms:title>
		<dcterms:title xml:lang="fr">Description</dcterms:title>
		<dcterms:description xml:lang="en"><p> An account of the resource. <small> (<i> source: <a href="http://purl.org/dc/elements/1.1/description">DCMI</a></i>) </small></p><p> Descriptive text (reference: Dublin Core) about resource represented as rich text in XHTML content. SHOULD include only content that is valid and suitable inside an XHTML 'div' element. <small> (<i> source: <a href="http://open-services.net/">OSLC</a></i>) </small></p></dcterms:description>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxOccurs>1</xs:maxOccurs>
			</xs:restriction>
		</xs:simpleType>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty id="cas:Diagram" cas:itemType="cas:Property">
		<dcterms:title xml:lang="en">Diagram</dcterms:title>
		<dcterms:title xml:lang="de">Diagramm</dcterms:title>
		<dcterms:title xml:lang="fr">Diagramme</dcterms:title>
		<skos:definition xml:lang="en">A diagram illustrating the resource or a link to a diagram.</skos:definition>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</owl:DatatypeProperty>
	<owl:Class id="SpecIF:Paragraph" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title xml:lang="en">Paragraph</dcterms:title>
		<dcterms:title xml:lang="de">Textabsatz</dcterms:title>
		<dcterms:title xml:lang="fr">Paragraphe</dcterms:title>
		<dcterms:description xml:lang="en"><p>A 'Paragraph' is an unspecified information in a document at any level.</p></dcterms:description>
		<dcterms:description xml:lang="de"><p>Ein 'Textabschnitt' in einem Dokument auf beliebiger Ebene.</p></dcterms:description>
		<cas:enumeratedProperty>
			<idRef>cas:Diagram</idRef>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="FMC:Actor" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title xml:lang="en">Actor</dcterms:title>
		<dcterms:title xml:lang="de">Akteur</dcterms:title>
		<dcterms:title xml:lang="fr">Acteur</dcterms:title>
		<dcterms:description xml:lang="en"><p>An 'Actor' is a fundamental model element type representing an active entity, be it an activity, a process step, a function, a system component or a role.</p><p>The particular use or original type is specified with a [[dcterms:type]] property of the 'FMC:Actor'. A value of that property should be an ontology-term, such as [[bpmn:processStep]].</p></dcterms:description>
		<dcterms:description xml:lang="de"><p>Ein 'Akteur' ist ein fundamentaler Modellelementtyp, der eine aktive Entität darstellt, sei es eine Aktivität, ein Prozessschritt, eine Funktion, eine Systemkomponente oder eine Rolle.</p><p>Die spezielle Verwendung oder der ursprüngliche Typ wird mit einer [[dcterms:type]] Eigenschaft von 'FMC:Actor' spezifiziert. Die Werte dieser Eigenschaft können Ontologiebegriffe sein, wie z.B. [[bpmn:timer]].</p></dcterms:description>
		<dcterms:description xml:lang="fr"><p>Un 'Acteur' est un type d'élément de modèle fondamental représentant une entité active, qu'il s'agisse d'une activité, d'une étape de processus, d'une fonction, d'un composant de système ou d'un rôle.</p><p>L'utilisation particulière ou le type original est spécifié avec une propriété [[dcterms:type]] de 'FMC:Actor'. Les valeurs de cette propriété peuvent être des termes d'ontologie, tels que [[bpmn:timer]].</p></dcterms:description>
		<cas:icon>□</cas:icon>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="FMC:State" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title xml:lang="en">State</dcterms:title>
		<dcterms:title xml:lang="de">Zustand</dcterms:title>
		<dcterms:title xml:lang="fr">État</dcterms:title>
		<dcterms:description xml:lang="en"><p>A 'State' is a fundamental model element type representing a passive entity, be it a value, a condition, an information storage or even a physical shape.</p><p>The particular use or the original type is specified with a [[dcterms:type]] property of the 'FMC:State'. A value of that property should bean ontology-term, such as [[bpmn:dataObject]].</p></dcterms:description>
		<dcterms:description xml:lang="de"><p>Ein 'Zustand' ist ein fundamentaler Modellelementtyp, der eine passive Entität darstellt, sei es ein Wert, ein Dokument, ein Informationsspeicher, eine Bedingung oder eine physische Beschaffenheit.</p><p>Die spezielle Verwendung oder der ursprüngliche Typ wird mit einer [[dcterms:type]] Eigenschaft von 'FMC:State' spezifiziert. Die Werte dieser Eigenschaft können Ontologiebegriffe sein, wie z.B. [[ArchiMate:DataObject]].</p></dcterms:description>
		<dcterms:description xml:lang="fr"><p>Un 'État' est un type d'élément de modèle fondamental représentant une entité passive, qu'il s'agisse d'une valeur, d'une condition, d'un stockage d'informations ou même d'une forme physique.</p><p>L'utilisation particulière ou le type original est spécifié avec une propriété [[dcterms:type]] de 'FMC:State'. Les valeurs de cette propriété peuvent être des termes d'ontologie, tels que [[ArchiMate:DataObject]].</p></dcterms:description>
		<cas:icon>○</cas:icon>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="FMC:Event" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title xml:lang="en">Event</dcterms:title>
		<dcterms:title xml:lang="de">Ereignis</dcterms:title>
		<dcterms:title xml:lang="fr">Évenement</dcterms:title>
		<dcterms:description xml:lang="en"><p>An 'Event' is a fundamental model element type representing a time reference, a change in condition/value or more generally a synchronization primitive.</p><p>The particular use or the original type is specified with a [[dcterms:type]] property of the 'FMC:Event'. A value of that property should be an ontology-term, such as [[bpmn:startEvent]].</p></dcterms:description>
		<dcterms:description xml:lang="de"><p>Ein 'Ereignis' ist ein fundamentaler Modellelementtyp, der eine Zeitreferenz, eine Änderung einer Bedingung/eines Wertes oder allgemeiner ein Synchronisationsmittel darstellt.</p><p>Die spezielle Verwendung oder der ursprüngliche Typ wird mit einer [[dcterms:type]] Eigenschaft von 'FMC:Event' spezifiziert. Die Werte dieser Eigenschaft sollen Ontologiebegriffe sein, wie z.B. [[bpmn:startEvent]].</p></dcterms:description>
		<dcterms:description xml:lang="fr"><p>Un 'Événement' est un type d'élément de modèle fondamental représentant une référence temporelle, un changement de condition/valeur ou plus généralement une primitive de synchronisation.</p><p>L'utilisation particulière ou le type original est spécifié avec une propriété [[dcterms:type]] de 'FMC:Event'. Les valeurs de cette propriété peuvent être des termes d'ontologie, tels que [[bpmn:startEvent]].</p></dcterms:description>
		<cas:icon>♢</cas:icon>
		<cas:enumeratedProperty>
			<idRef>cas:Category</idRef>
		</cas:enumeratedProperty>
	</owl:Class>
	<owl:Class id="IREB:Requirement" cas:itemType="cas:Entity">
		<cas:specializes>cas:Entity</cas:specializes>
		<dcterms:title xml:lang="en">Requirement</dcterms:title>
		<dcterms:title xml:lang="de">Anforderung</dcterms:title>
		<dcterms:title xml:lang="fr">Exigence</dcterms:title>
		<dcterms:description xml:lang="en"><p> A 'Requirement' is a singular documented physical and functional need that a particular design, product or process must be able to perform. <small> (<i> source: <a href="https://en.wikipedia.org/wiki/Requirement">Wikipedia</a></i>) </small></p><p>Definition:</p><ol><li>A condition or capability needed by a user to solve a problem or achieve an objective.</li><li>A condition or capability that must be met or possessed by a system or system component to satisfy a contract, standard, specification, or other formally imposed documents.</li><li>A documented representation of a condition or capability as in (1) or (2).</li></ol><p>Note: The definition above is the classic one from IEEE Std 610.12 of 1990. Alternatively, we also give a more modern definition:</p><ol><li>A need perceived by a stakeholder.</li><li>A capability or property that a system shall have.</li><li>A documented representation of a need, capability or property.</li></ol></dcterms:description>
		<dcterms:description xml:lang="de"><p> Eine 'Anforderung' ist ein einzelnes dokumentiertes physisches und funktionales Bedürfnis, das ein bestimmter Entwurf, ein Produkt oder ein Prozess erfüllen muss. <small> (<i> source: <a href="https://en.wikipedia.org/wiki/Requirement">Wikipedia</a></i>) </small></p><p>Definition:</p><ol><li>Eine Bedingung oder Fähigkeit, die ein Benutzer benötigt, um ein Problem zu lösen oder ein Ziel zu erreichen.</li><li>Eine Bedingung oder Fähigkeit, die ein System oder eine Systemkomponente erfüllen oder besitzen muss, um einen Vertrag, eine Norm, eine Spezifikation oder ein anderes formal vorgeschriebenes Dokument zu erfüllen.</li><li>Eine dokumentierte Darstellung einer Bedingung oder Fähigkeit wie in (1) oder (2).</li></ol><p>Anmerkung: Die obige Definition ist die klassische Definition aus IEEE Std 610.12 von 1990. Alternativ geben wir auch eine modernere Definition an:</p><ol><li>Ein von einem Stakeholder wahrgenommener Bedarf.</li><li>Eine Fähigkeit oder Eigenschaft, die ein System haben soll.</li><li>Eine dokumentierte Darstellung eines Bedarfs, einer Fähigkeit oder Eigenschaft.</li></ol></dcterms:description>
		<dcterms:description xml:lang="fr"><p> Une 'Exigence' est un besoin physique et fonctionnel unique et documenté qu'une conception, un produit ou un processus particulier doit pouvoir satisfaire. <small> (<i> source: <a href="https://en.wikipedia.org/wiki/Requirement">Wikipedia</a></i>) </small></p><p>Définition:</p><ol><li>Condition ou capacité dont un utilisateur a besoin pour résoudre un problème ou atteindre un objectif.</li><li>Condition ou capacité qui doit être remplie ou possédée par un système ou un composant de système pour satisfaire à un contrat, à une norme, à une spécification ou à d'autres documents imposés officiellement.</li><li>Une représentation documentée d'une condition ou d'une capacité comme dans (1) ou (2).</li></ol><p>Remarque: La définition ci-dessus est la définition classique de la norme IEEE 610.12 de 1990. Nous donnons également une définition plus moderne:</p><ol><li>Un besoin perçu par une partie prenante;</li><li>Une capacité ou une propriété qu'un système doit avoir.</li><li>Une représentation documentée d'un besoin, d'une capacité ou d'une propriété.</li></ol></dcterms:description>
		<cas:icon>↯</cas:icon>
		<cas:enumeratedTargetLink>
			<idRef>SpecIF:Priority</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:Class id="SpecIF:writes" cas:itemType="cas:Relationship">
		<dcterms:title xml:lang="en">writes</dcterms:title>
		<dcterms:title xml:lang="de">schreibt</dcterms:title>
		<dcterms:title xml:lang="fr">écrit</dcterms:title>
		<dcterms:description xml:lang="en">A [[FMC:Actor]] 'writes' (changes) a [[FMC:State]].</dcterms:description>
		<cas:specializes>cas:Relationship</cas:specializes>
		<cas:enumeratedSourceLink>
			<idRef>SpecIF:writes-toSource</idRef>
		</cas:enumeratedSourceLink>
		<cas:enumeratedTargetLink>
			<idRef>SpecIF:writes-toTarget</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:ObjectProperty id="SpecIF:writes-toSource" cas:itemType="cas:Link">
		<cas:specializes>cas:linksSource</cas:specializes>
		<dcterms:title>SpecIF:writes to source</dcterms:title>
		<skos:definition>Connects the source of SpecIF:writes</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>FMC:Actor</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="SpecIF:writes-toTarget" cas:itemType="cas:Link">
		<cas:specializes>cas:linksTarget</cas:specializes>
		<dcterms:title>SpecIF:writes to target</dcterms:title>
		<skos:definition>Connects the target of SpecIF:writes</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>FMC:State</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:Class id="SpecIF:reads" cas:itemType="cas:Relationship">
		<dcterms:title xml:lang="en">reads</dcterms:title>
		<dcterms:title xml:lang="de">liest</dcterms:title>
		<dcterms:title xml:lang="fr">lit</dcterms:title>
		<dcterms:description xml:lang="en">A [[FMC:Actor]] 'reads' a [[FMC:State]].</dcterms:description>
		<cas:specializes>cas:Relationship</cas:specializes>
		<cas:enumeratedSourceLink>
			<idRef>SpecIF:reads-toSource</idRef>
		</cas:enumeratedSourceLink>
		<cas:enumeratedTargetLink>
			<idRef>SpecIF:reads-toTarget</idRef>
		</cas:enumeratedTargetLink>
	</owl:Class>
	<owl:ObjectProperty id="SpecIF:reads-toSource" cas:itemType="cas:Link">
		<cas:specializes>cas:linksSource</cas:specializes>
		<dcterms:title>SpecIF:reads to source</dcterms:title>
		<skos:definition>Connects the source of SpecIF:reads</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>FMC:Actor</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:ObjectProperty id="SpecIF:reads-toTarget" cas:itemType="cas:Link">
		<cas:specializes>cas:linksTarget</cas:specializes>
		<dcterms:title>SpecIF:reads to target</dcterms:title>
		<skos:definition>Connects the target of SpecIF:reads</skos:definition>
		<cas:enumeratedEndpoint>
			<idRef>FMC:State</idRef>
		</cas:enumeratedEndpoint>
	</owl:ObjectProperty>
	<owl:Class id="oslc_rm:satisfies" cas:itemType="cas:Relationship">
		<dcterms:title xml:lang="en">satisfies</dcterms:title>
		<dcterms:title xml:lang="de">erfüllt</dcterms:title>
		<dcterms:title xml:lang="fr">satisfait</dcterms:title>
		<dcterms:description xml:lang="en"><p> The object is satisfied by the subject. <small> (<i> source: <a href="http://open-services.net/">OSLC</a></i>) </small></p><p> SpecIF suggests that the subject is confined to a model element, e.g, a [[FMC:Actor]] or [[FMC:State]], and the object is confined to a [[IREB:Requirement]]. More concretely, an example for this type of statement is 'Component-X <em>satisfies</em> 'Requirement-4711'. </p></dcterms:description>
		<cas:specializes>cas:Relationship</cas:specializes>
		<cas:enumeratedSourceLink>
			<idRef>oslc_rm:satisfies-toSource</idRef>
		</cas:enumeratedSourceLink>
		<cas:enumeratedTargetLink>
