	dcterms:modified "2016-05-26T08:59:00+02:00"^^xs:dateTime .

SpecIF:refersTo_shape
	a sh:NodeShape ;
	sh:targetClass SpecIF:refersTo ;
	sh:property SpecIF:refersTo-toSource_shape ;
	sh:property SpecIF:refersTo-toTarget_shape .

SpecIF:refersTo-toSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksSource ;
	rdfs:label "SpecIF:refersTo to source" ;
	rdfs:comment "Connects the source of SpecIF:refersTo" ;
	rdfs:range SpecIF:Issue .

SpecIF:refersTo-toSource_shape
	a sh:PropertyShape ;
	sh:path SpecIF:refersTo-toSource ;
	sh:class SpecIF:Issue .

SpecIF:refersTo-toTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "SpecIF:refersTo to target" ;
	rdfs:comment "Connects the target of SpecIF:refersTo" ;
	rdfs:range [ owl:unionOf ( cas:View FMC:Actor FMC:State FMC:Event IREB:Requirement ) ] .

SpecIF:refersTo-toTarget_shape
	a sh:PropertyShape ;
	sh:path SpecIF:refersTo-toTarget ;
	sh:or ( [ sh:class cas:View ] [ sh:class FMC:Actor ] [ sh:class FMC:State ] [ sh:class FMC:Event ] [ sh:class IREB:Requirement ] ) .

