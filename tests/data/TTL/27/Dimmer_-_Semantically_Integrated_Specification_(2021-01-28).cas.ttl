d:Req-5b8fbb300000bca80137c73e3ce4c737
	a IREB:Requirement ;
	rdfs:label "Electric load is 120 W" ;
	rdfs:comment "<div><p>The power stage must allow an electric load of 120 W.</p></div>" ;
	cas:revision "25" ;
