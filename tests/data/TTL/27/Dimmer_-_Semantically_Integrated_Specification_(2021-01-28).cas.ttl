d:MEl-5bcfb01d0000bca80137f303272a5557
	a FMC:Actor ;
	rdfs:label "Shading" ;
	rdfs:comment "<div><p>Window-shade with 2 degrees of freedom: It can be moved up/down and the elements can be set straight/tilted. Both movements can be made proportionally with an electric drive.</p></div>" ;
	cas:revision "50" ;
	dcterms:modified "2017-06-19T20:13:19+02:00"^^xs:dateTime ;
	dcterms:creator "od" .

d:MEl-5a50d5b60000bca8013781532547ce93
	a FMC:Actor ;
	rdfs:label "SmartHome Controller" ;
	rdfs:comment "<div><p>The controller </p><ul><li>interconnects locally distributed sensors and actuators, </li><li>coordinates different actuators where appropriate and </li><li>performes automatic functions, such as switching external lamps dependend on ambient light.</li></ul></div>" ;
	cas:revision "51" ;
	dcterms:modified "2017-06-19T20:13:19+02:00"^^xs:dateTime ;
	dcterms:creator "od" .

d:MEl-803fd3750000c3a8013cf1fdb3b26d33
	a FMC:State ;
	rdfs:label "SmartHome System" ;
	rdfs:comment "<div><p>The new system for controlling all major functions of the private home:</p><ul><li>light/illumination</li><li>window shades</li><li>heating</li><li>consumption meters for electricity, heat, gas and water.</li></ul></div>" ;
	cas:revision "73" ;
	dcterms:modified "2017-06-19T20:13:26+02:00"^^xs:dateTime ;
	dcterms:creator "od" .

