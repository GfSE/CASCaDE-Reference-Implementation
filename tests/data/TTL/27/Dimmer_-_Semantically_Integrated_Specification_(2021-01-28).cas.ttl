d:Req-d1c895230000c3a80150f8afd049f738
	a IREB:Requirement ;
	rdfs:label "Dim an electric load" ;
	rdfs:comment "<div><p> The user can set the intensity level of an electric load such as a light [[bulb]]. Pressing a button 'up' or 'down', the intensity is increased or decreased following a quasi-stepless ramp. <br /></p></div>" ;
	cas:revision "23" ;
	dcterms:modified "2017-06-19T20:13:06+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_014" ;
	ReqIF-WF:SupplierComment "Our solution does this perfectly." ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusApproved ;
	SpecIF:Priority SpecIF:priorityMedium ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupUser ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineMechanics ,
		SpecIF:EngineeringDisciplineElectronics ,
		SpecIF:EngineeringDisciplineSoftware ;
	ReqIF-WF:SupplierStatus ReqIF-WF:SupplierStatus.Agreed .

d:Req-d1d42a6a0000c3a8015091ec8d149b93
	a IREB:Requirement ;
	rdfs:label "Switch an electric load" ;
	rdfs:comment "<div><p> The user can immediately switch 'on' or 'off' the electric load. The intensity set to the maximum resp. minimum level, as defined by installation parameters.</p></div>" ;
	cas:revision "243" ;
	dcterms:modified "2018-02-13T12:22:44+01:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_016" ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusApproved ;
	SpecIF:Priority SpecIF:priorityMedium ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupUser ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineElectronics ,
		SpecIF:EngineeringDisciplineSoftware .

d:Req-d1cd7f370000c3a8015095e6ee21aab7
	a IREB:Requirement ;
	rdfs:label "Set dimming parameters" ;
	rdfs:comment "<div><p> During system setup, the installer can modify the following parameters: </p><ul><li> maximum intensity </li><li> minimum intensity </li><li> dimming speed (intensity ramp when dimming) </li></ul></div>" ;
	cas:revision "24" ;
	dcterms:modified "2017-06-19T20:13:07+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_015" ;
