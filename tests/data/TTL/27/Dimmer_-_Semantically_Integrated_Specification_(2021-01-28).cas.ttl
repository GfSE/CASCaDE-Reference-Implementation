	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineMechanics ,
		SpecIF:EngineeringDisciplineElectronics ,
		SpecIF:EngineeringDisciplineSafety .

d:Req-5b95fae40000bca801372becc933682d
	a IREB:Requirement ;
	rdfs:label "Industry-standard mounting" ;
	rdfs:comment "<div><p> The product fits into an industry-standard [[housing]] for flush-mounted devices (diameter &#x2300;68 mm). It is fixed with two screw-activated claws.</p></div>" ;
