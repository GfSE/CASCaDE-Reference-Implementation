	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineMechanics ,
		SpecIF:EngineeringDisciplineSoftware ;
	ReqIF-WF:SupplierStatus ReqIF-WF:SupplierStatus.Agreed .

d:Req-5ba140d60000bca801372b09f9888eca
	a IREB:Requirement ;
	rdfs:label "Instantaneous reaction" ;
	rdfs:comment "<div><p> The reaction time of the system to user input is 'instantaneous' (&lt; 0,5 sec).</p></div>" ;
	cas:revision "252" ;
	dcterms:modified "2018-03-08T11:59:42+01:00"^^xs:dateTime ;
	dcterms:creator "supplier" ;
	dcterms:identifier "REQ_008" ;
	ReqIF-WF:SupplierComment "Mais bien sûr." ;
	ReqIF-WF:CustomerComment "Das ist ganz wichtig für uns." ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusDone ;
	SpecIF:Priority SpecIF:priorityHigh ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupUser ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineSoftware ;
	ReqIF-WF:SupplierStatus ReqIF-WF:SupplierStatus.Agreed ;
	ReqIF-WF:CustomerStatus ReqIF-WF:CustomerStatus.ToEvaluate .

d:Req-ee452cf20000c3a8014035290669304d
	a IREB:Requirement ;
	rdfs:label "Consistent system behavior" ;
	rdfs:comment "<div><p>The system's behavior must be consistent. For example, controlling a dimmer must correspond with controlling a shade.</p></div>" ;
	cas:revision "27" ;
	dcterms:modified "2017-06-19T20:13:10+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_011" ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusApproved ;
	SpecIF:Priority SpecIF:priorityMedium ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupUser ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineMechanics ,
		SpecIF:EngineeringDisciplineSoftware .

d:Req-ee43fc4c0000c3a8014063d42c77767f
	a IREB:Requirement ;
	rdfs:label "No dead-locks" ;
	rdfs:comment "<div><p>Under no circumstances the system may get stuck in a dead-lock. I.e. every sequence of input stimulation must be supported, even arbitrary sequences. Input stimulation which is not supported in a given system state is either refused with an error message, if a feedback channel is available, or it is simply ignored, otherwise.</p></div>" ;
	cas:revision "28" ;
	dcterms:modified "2017-06-19T20:13:11+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_010" ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusApproved ;
	SpecIF:Priority SpecIF:priorityHigh ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupSystem ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineElectronics ,
		SpecIF:EngineeringDisciplineSoftware .

d:Req-5b9124bc0000bca80137fa2ce86f5eca
	a IREB:Requirement ;
	rdfs:label "Overload protection" ;
	rdfs:comment "<div><p>The dimmer unit is protected against resistive overload and against any capacitive or inductive loads.</p></div>" ;
	cas:revision "29" ;
	dcterms:modified "2017-06-19T20:13:11+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_002" ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusSubmitted ;
	SpecIF:Priority SpecIF:priorityMedium ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupUser ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineElectronics .

d:Req-5b9e68530000bca801371362c49d2d08
	a IREB:Requirement ;
	rdfs:label "Auto shut-off" ;
	rdfs:comment "<div><p>In case of over-temperature the device is shut-off automatically by an electronic circuit.</p></div>" ;
	cas:revision "29" ;
	dcterms:modified "2017-06-19T20:13:11+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
	dcterms:identifier "REQ_007" ;
	SpecIF:LifecycleStatus SpecIF:LifecycleStatusSubmitted ;
	SpecIF:Priority SpecIF:priorityMedium ;
	SpecIF:StakeholderGroup SpecIF:StakeholderGroupSystem ;
	SpecIF:EngineeringDiscipline SpecIF:EngineeringDisciplineElectronics .

d:Req-eea1cd500000c3a80140fe00109eb7f4
	a IREB:Requirement ;
	rdfs:label "Compliance with industry standards" ;
	rdfs:comment "<div><p>The system must comply with industry standards. Besides legal and safety requirements, compatibility with existing electrical installations, tools and commercial components is desired.</p></div>" ;
	cas:revision "31" ;
	dcterms:modified "2017-06-19T20:13:12+02:00"^^xs:dateTime ;
	dcterms:creator "od" ;
