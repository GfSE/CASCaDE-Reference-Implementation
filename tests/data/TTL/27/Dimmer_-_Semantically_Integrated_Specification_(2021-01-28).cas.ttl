d:Req-5b944fc70000bca8013763f44fdc0e03
	a IREB:Requirement ;
	rdfs:label "Instant use" ;
	rdfs:comment "<div><p>85% of an arbitrarily selected group of test users understands and can use the system without reading a manual.</p></div>" ;
	cas:revision "26" ;
	dcterms:modified "2017-06-19T20:13:09+02:00"^^xs:dateTime ;
