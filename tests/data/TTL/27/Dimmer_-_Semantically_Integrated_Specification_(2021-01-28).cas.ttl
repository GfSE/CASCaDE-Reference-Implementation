d:ACP-59c8a7730000bca80137509a49b1218b_ontology
	a owl:Ontology ;
	owl:versionInfo "2026-07-20" .

d:ACP-59c8a7730000bca80137509a49b1218b
	a cas:Package ;
	rdfs:label "Dimmer - Semantically Integrated Specification (2021-01-28)" ;
	rdfs:comment "This specification method integrates and represents:\n- processes, system composition and requirements (dynamic, static and detail views)\n- mechanic, electric and software components with their interfaces.\n\nIt is important to understand, that all plans (diagrams) are views of a common system engineering model, sometimes called 'system repository'. Thus, consistency is always maintained.\n\nThe model elements are connected with relations, most of which are defined by positioning graph elements. For example, if a system component is drawn within another, a relationship 'contains' is created in the logic representation of the engineering model. Other relations, such as a system component 'satisfies' a requirement are created manually.  \n\nAlso, the documents are generated from the system engineering model. The ordering is in most projects (it can be rearranged, however, if appropriate):\n- All plans\n- A glossary with descriptions of all model elements appearing on one or more plans\n- A hierarchically ordered list of requirements\n- A list of open issues.\nPlease note that plans list related model elements and model elements list related requirements .. and vice versa. Active hyper-links are used, so that it is easy to jump between related model elements.\n\nFurther information is given in Appendix 'Method'." ;
	dcterms:modified "2026-09-30T09:18:13.144Z"^^xs:dateTime ;
	dcterms:creator "od@enso-managers.de" .

#################################################################
# Graph Items
#################################################################

cas:Organizer
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label "Organizer" ;
	skos:definition "A CASCaRA meta-model item for organizing model-elements. An example is a list of requirements or a diagram using a certain notation." .

cas:Organizer_shape
	a sh:NodeShape ;
	sh:targetClass cas:Organizer ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) .

cas:Package
	a owl:Class ;
	rdfs:subClassOf cas:Organizer ;
	rdfs:label "Package" ;
	skos:definition "A subclass of cas:Organizer used for a partial graph selected for exchange or access permissions." .

cas:Package_shape
	a sh:NodeShape ;
	sh:targetClass cas:Package ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) .

cas:Root
	a owl:Class ;
	rdfs:subClassOf cas:Organizer ;
	rdfs:label "Root" ;
	skos:definition "A subclass of cas:Organizer serving as a root for trees and tables." .

cas:Root_shape
	a sh:NodeShape ;
	sh:targetClass cas:Root ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) ;
	sh:property cas:lists_shape .

cas:Tree
	a owl:Class ;
	rdfs:subClassOf cas:Organizer ;
	rdfs:label "Tree" ;
	skos:definition "A subclass of cas:Organizer for strictly hierarchical data structures referencing entities and relationships." .

cas:Tree_shape
	a sh:NodeShape ;
	sh:targetClass cas:Tree ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) ;
	sh:property cas:lists_shape .

cas:Outline
	a owl:Class ;
	rdfs:subClassOf cas:Tree ;
	rdfs:label "Outline" ;
	skos:definition "A subclass of cas:Tree comprising all information items of a human-readable document. As usual, the outline is hierarchically organized." .

cas:Outline_shape
	a sh:NodeShape ;
	sh:targetClass cas:Outline ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) .

cas:Table
	a owl:Class ;
	rdfs:subClassOf cas:Organizer ;
	rdfs:label "Table" ;
	skos:definition "A subclass of cas:Organizer representing a table showing selected model elements." .

cas:Table_shape
	a sh:NodeShape ;
	sh:targetClass cas:Table ;
	sh:or ( [ sh:path rdfs:label ; sh:minCount 1 ] [ sh:path rdfs:comment ; sh:minCount 1 ] ) ;
	sh:property cas:shows_shape .

cas:Diagram
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Property ;
	rdfs:label "Diagram" ;
	skos:definition "A diagram illustrating the resource or a link to a diagram." .

cas:Diagram_shape
	a sh:PropertyShape ;
	sh:path cas:Diagram ;
	sh:datatype xs:string ;
	sh:minCount "0" .

cas:Category
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Property ;
	rdfs:label "has category" ;
	skos:definition "Specifies a category for an element (entity, relationship or organizer)." .

cas:Category_shape
	a sh:PropertyShape ;
	sh:path cas:Category ;
	sh:datatype xs:string ;
	sh:minCount "0" ;
	sh:maxCount "1" ;
	sh:maxLength "32" .

cas:Notation
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Category ;
	rdfs:label "Notation" ;
	skos:definition "A reference to a notation defining the syntax and semantics of a diagram." .

cas:Notation_shape
	a sh:PropertyShape ;
	sh:path cas:Notation ;
	sh:datatype xs:string ;
	sh:minCount "0" ;
	sh:maxCount "1" .

cas:linksSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label "to source" ;
	skos:definition "Connects the source of a reified relationship." ;
	rdfs:range [ owl:unionOf ( cas:Entity cas:Relationship ) ] .

cas:linksSource_shape
	a sh:PropertyShape ;
	sh:path cas:linksSource ;
	sh:or ( [ sh:class cas:Entity ] [ sh:class cas:Relationship ] ) .

cas:linksTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label "to target" ;
	skos:definition "Connects the target of a reified relationship or an organizer." ;
	rdfs:range [ owl:unionOf ( cas:Entity cas:Relationship ) ] .

cas:linksTarget_shape
	a sh:PropertyShape ;
	sh:path cas:linksTarget ;
	sh:or ( [ sh:class cas:Entity ] [ sh:class cas:Relationship ] ) .

cas:lists
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "lists" ;
	skos:definition "Lists an entity, a relationship or a subordinated organizer." ;
	rdfs:range [ owl:unionOf ( cas:Entity cas:Relationship cas:Organizer ) ] .

cas:lists_shape
	a sh:PropertyShape ;
	sh:path cas:lists ;
	sh:or ( [ sh:class cas:Entity ] [ sh:class cas:Relationship ] [ sh:class cas:Organizer ] ) .

cas:shows
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "shows" ;
	skos:definition "Shows an entity or a relationship." ;
	rdfs:range [ owl:unionOf ( cas:Entity cas:Relationship ) ] .

cas:shows_shape
	a sh:PropertyShape ;
	sh:path cas:shows ;
	sh:or ( [ sh:class cas:Entity ] [ sh:class cas:Relationship ] ) .

cas:depicts
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:linksTarget ;
	rdfs:label "depicts" ;
	skos:definition "Depicts an entity; inverse of uml:ownedDiagram." ;
	rdfs:range cas:Entity .

cas:depicts_shape
	a sh:PropertyShape ;
	sh:path cas:depicts ;
	sh:class cas:Entity .

